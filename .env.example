# =============================================================================
# CUDA RAY TRACER ENVIRONMENT CONFIGURATION
# =============================================================================

# Backend Server Configuration
PORT=8080
HOST=0.0.0.0
PYTHONUNBUFFERED=1

# Optional: If running an API Gateway on Render that forwards to a remote GPU worker:
# GPU_WORKER_URL=https://worker-id.runpod.net

# Frontend Configuration
# ----------------------
# Local Development (talking to local or remote GPU server):
VITE_API_BASE_URL=http://localhost:8080

# Production Netlify Deployment (pointing to publicly hosted API Gateway or GPU Server):
# Set this in Netlify Environment Variables UI (Site configuration -> Environment variables):
# VITE_API_BASE_URL=https://cuda-raytracer-api.onrender.com
